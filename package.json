{
  "name": "aurora-ecar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/build-vercel.mjs",
    "catalog:export:static": "node scripts/export-static-catalog.mjs",
    "lint": "oxlint src server scripts tests e2e *.config.ts",
    "preview": "vite preview",
    "test": "vitest run --environment jsdom",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "catalog:import": "tsx scripts/import-chevrolet-catalog.ts",
    "catalog:validate": "tsx scripts/validate-chevrolet-catalog.ts",
    "images:sync": "tsx scripts/sync-chevrolet-images.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node server/dist/main.js",
    "api:dev": "npm run api:build && npm run api:start",
    "test:api": "tsx --test tests/catalog-api.test.ts",
    "test:idempotence": "tsx scripts/test-idempotence.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run test:api && npm test && npm run test:idempotence",
    "images:manifest": "node scripts/prepare-image-assets.mjs && node scripts/append-vedo-images.mjs",
    "start": "node scripts/start-local.mjs",
    "db:local:start": "node scripts/start-local-db.mjs",
    "discounts:import": "tsx scripts/import-discounts.ts",
    "test:http": "tsx scripts/test-http.ts",
    "images:references": "tsx scripts/sync-version-references.ts",
    "catalog:audit": "tsx scripts/audit-catalog.ts",
    "deploy:export": "node scripts/export-deploy-database.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "mysql2": "^3.24.4"
  }
}
