{$SITE_DOMAIN} {
 encode zstd gzip
 header X-Content-Type-Options nosniff
 header Referrer-Policy strict-origin-when-cross-origin
 handle /api/* {
  reverse_proxy api:3001
 }
 handle /assets/* {
  root * /srv
  file_server
 }
 handle {
  root * /srv
  try_files {path} /index.html
  file_server
 }
}
